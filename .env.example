# ─────────────────────────────────────────────
#  MediaPulse — Variables d'environnement
#  Copie ce fichier en .env et remplis les valeurs
# ─────────────────────────────────────────────

# YouTube Data API v3
# 1. Va sur https://console.cloud.google.com
# 2. Crée un projet → Bibliothèque → cherche "YouTube Data API v3" → Activer
# 3. Identifiants → Créer des identifiants → Clé API
YOUTUBE_API_KEY=

# ─── Optionnel pour la V1 (non utilisé encore) ───

# OpenAI (Whisper — transcription)
OPENAI_API_KEY=

# Cloudflare R2 (stockage audio)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mediapulse-audio
R2_ENDPOINT=

# Supabase — PostgreSQL (REQUIS en production)
# Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Resend (emails d'alerte)
RESEND_API_KEY=

# App
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
